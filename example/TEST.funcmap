ha:funcmap.v1 {
  ha:comp_attribs {
    li:funcmap/ports {
      { GP0/GP0         -> sigtype=digital;         }
      { GP0/SPI0.0 RX   -> sigtype=digital; dir=in  }
      { GP0/I2C0.0 SDA  -> sigtype=digital;         }
      { GP0/UART0.0 TX  -> sigtype=digital; dir=out }

      { GP1/GP1         -> sigtype=digital;         }
      { GP1/SPI0.0 CSn  -> sigtype=digital; dir=in  }
      { GP1/I2C0.0 SCL  -> sigtype=digital;         }
      { GP1/UART0.0 RX  -> sigtype=digital; dir=in  }

      { GP2/GP2         -> sigtype=digital;         }
      { GP2/SPI0.0 SCK  -> sigtype=digital;         }
      { GP2/I2C1.0 SDA  -> sigtype=digital;         }

      { GP3/GP3         -> sigtype=digital;         }
      { GP3/SPI0.0 TX   -> sigtype=digital; dir=out }
      { GP3/I2C1.0 SCL  -> sigtype=digital;         }

      { GP4/GP4         -> sigtype=digital;         }
      { GP4/SPI0.1 RX   -> sigtype=digital; dir=in  }
      { GP4/I2C0.1 SDA  -> sigtype=digital;         }
      { GP4/UART1.0 TX  -> sigtype=digital; dir=out }

      { GP5/GP5         -> sigtype=digital;         }
      { GP5/SPI0.1 CSn  -> sigtype=digital; dir=in  }
      { GP5/I2C0.1 SCL  -> sigtype=digital;         }
      { GP5/UART1.0 RX  -> sigtype=digital; dir=in  }

      { GP6/GP6         -> sigtype=digital;         }
      { GP6/SPI0.1 SCK  -> sigtype=digital;         }
      { GP6/I2C1.1 SDA  -> sigtype=digital;         }

      { GP7/GP7         -> sigtype=digital;         }
      { GP7/SPI0.1 TX   -> sigtype=digital; dir=out }
      { GP7/I2C1.1 SCL  -> sigtype=digital;         }

      { GP8/GP8         -> sigtype=digital;         }
      { GP8/SPI1.0 RX   -> sigtype=digital; dir=in  }
      { GP8/I2C0.2 SDA  -> sigtype=digital;         }
      { GP8/UART1.1 TX  -> sigtype=digital; dir=out }

      { GP9/GP9         -> sigtype=digital;         }
      { GP9/SPI1.0 CSn  -> sigtype=digital; dir=in  }
      { GP9/I2C0.2 SCL  -> sigtype=digital;         }
      { GP9/UART1.1 RX  -> sigtype=digital; dir=in  }

      { GP10/GP10       -> sigtype=digital;         }
      { GP10/SPI1.0 SCK -> sigtype=digital;         }
      { GP10/I2C1.2 SDA -> sigtype=digital;         }

      { GP11/GP11       -> sigtype=digital;         }
      { GP11/SPI1.0 TX  -> sigtype=digital; dir=out }
      { GP11/I2C1.2 SCL -> sigtype=digital;         }

      { GP12/GP12       -> sigtype=digital;         }
      { GP12/SPI1.1 RX  -> sigtype=digital; dir=in  }
      { GP12/I2C0.3 SDA -> sigtype=digital;         }
      { GP12/UART0.1 TX -> sigtype=digital; dir=out }

      { GP13/GP13       -> sigtype=digital;         }
      { GP13/SPI1.1 CSn -> sigtype=digital; dir=in  }
      { GP13/I2C0.3 SCL -> sigtype=digital;         }
      { GP13/UART0.1 RX -> sigtype=digital; dir=in  }

      { GP14/GP14       -> sigtype=digital;         }
      { GP14/SPI1.1 SCK -> sigtype=digital;         }
      { GP14/I2C1.3 SDA -> sigtype=digital;         }

      { GP15/GP15       -> sigtype=digital;         }
      { GP15/SPI1.1 TX  -> sigtype=digital; dir=out }
      { GP15/I2C1.3 SCL -> sigtype=digital;         }

      { GP16/GP16       -> sigtype=digital;         }
      { GP16/SPI0.2 RX  -> sigtype=digital; dir=in  }
      { GP16/I2C0.4 SDA -> sigtype=digital;         }
      { GP16/UART0.2 TX -> sigtype=digital; dir=out }

      { GP17/GP17       -> sigtype=digital;         }
      { GP17/SPI0.2 CSn -> sigtype=digital; dir=in  }
      { GP17/I2C0.4 SCL -> sigtype=digital;         }
      { GP17/UART0.2 RX -> sigtype=digital; dir=in  }

      { GP18/GP18       -> sigtype=digital;         }
      { GP18/SPI0.2 SCK -> sigtype=digital;         }
      { GP18/I2C1.4 SDA -> sigtype=digital;         }

      { GP19/GP19       -> sigtype=digital;         }
      { GP19/SPI0.2 TX  -> sigtype=digital; dir=out }
      { GP19/I2C1.4 SCL -> sigtype=digital;         }

      { GP20/GP20       -> sigtype=digital;         }
      { GP20/I2C0.5 SDA -> sigtype=digital;         }

      { GP21/GP21       -> sigtype=digital;         }
      { GP21/I2C0.5 SCL -> sigtype=digital;         }

      { GP26/GP26       -> sigtype=digital;         }
      { GP26/ADC0       -> sigtype=analog; dir=in   }
      { GP26/I2C1.5 SDA -> sigtype=digital;         }

      { GP27/GP27       -> sigtype=digital;         }
      { GP27/ADC1       -> sigtype=analog; dir=in   }
      { GP27/I2C1.5 SCL -> sigtype=digital;         }

      { GND33/GND33     -> sigtype=gnd              }
      { GND33/AGND      -> sigtype=gnd              }

      { GP28/GP28       -> sigtype=digital;         }
      { GP28/ADC2       -> sigtype=analog; dir=in   }
    }

    # sorting for display
    li:funcmap/weak_groups {
      { gpio -> GP0 GP1 GP2 GP3 GP4 GP5 GP6 GP7 GP8 GP9 GP10 GP11 GP12 GP13 GP14 GP15 GP16 GP17 GP18 GP19 GP20 GP21 GP26 GP27 GP28 }
    }

    # have to be selected all at once
    li:funcmap/strong_groups {
      { SPI0.0  -> SPI0.0 RX, SPI0.0 CSn, SPI0.0 SCK, SPI0.0 TX }
      { SPI0.1  -> SPI0.1 RX, SPI0.1 CSn, SPI0.1 SCK, SPI0.1 TX }
      { SPI0.2  -> SPI0.2 RX, SPI0.2 CSn, SPI0.2 SCK, SPI0.2 TX }

      { SPI1.0  -> SPI1.0 RX, SPI1.0 CSn, SPI1.0 SCK, SPI1.0 TX }
      { SPI1.1  -> SPI1.1 RX, SPI1.1 CSn, SPI1.1 SCK, SPI1.1 TX }

      { I2C0.0  -> I2C0.0 SDA, I2C0.0 SCL                       }
      { I2C0.1  -> I2C0.1 SDA, I2C0.1 SCL                       }
      { I2C0.2  -> I2C0.2 SDA, I2C0.2 SCL                       }
      { I2C0.3  -> I2C0.3 SDA, I2C0.3 SCL                       }
      { I2C0.4  -> I2C0.4 SDA, I2C0.4 SCL                       }
      { I2C0.5  -> I2C0.5 SDA, I2C0.5 SCL                       }

      { I2C1.0  -> I2C1.0 SDA, I2C1.0 SCL                       }
      { I2C1.1  -> I2C1.1 SDA, I2C1.1 SCL                       }
      { I2C1.2  -> I2C1.2 SDA, I2C1.2 SCL                       }
      { I2C1.3  -> I2C1.3 SDA, I2C1.3 SCL                       }
      { I2C1.4  -> I2C1.4 SDA, I2C1.4 SCL                       }
      { I2C1.5  -> I2C1.5 SDA, I2C1.5 SCL                       }

      { UART0.0 -> UART0.0 TX, UART0.0 RX                       }
      { UART0.1 -> UART0.1 TX, UART0.1 RX                       }
      { UART0.2 -> UART0.2 TX, UART0.2 RX                       }

      { UART1.0 -> UART1.0 TX, UART1.0 RX                       }
      { UART1.1 -> UART1.1 TX, UART1.1 RX                       }

      { ADC     -> ADC0, ADC1, AGND, ADC2                       }
    }
  }
}
